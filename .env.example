# ─── OCD Live — variables d'environnement ───────────────────────────────
# Copier ce fichier en .env.local (local) ou les saisir dans Vercel > Settings > Environment Variables.

# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ocdlive.com

# Numéro WhatsApp qui reçoit les réservations : format international SANS "+" ni espaces
# Exemple Togo : 22890123456
NEXT_PUBLIC_WHATSAPP_NUMBER=22890000000

# Canal d'envoi des réservations et candidatures :
#   whatsapp → phase 1 (ouverture de WhatsApp avec le message pré-rempli)
#   brevo    → phase 2 (emails transactionnels Brevo uniquement)
#   both     → WhatsApp + emails Brevo
# ⚠️ Lue au build : redéployer après modification.
NOTIFICATION_PROVIDER=whatsapp

# ─── Phase 2 : Brevo (obligatoire si NOTIFICATION_PROVIDER=brevo ou both) ───
BREVO_API_KEY=
# Expéditeur validé dans Brevo (Senders & IP)
BREVO_SENDER_EMAIL=reservations@ocdlive.com
# Adresse de l'équipe qui reçoit les nouvelles réservations
OCD_TEAM_EMAIL=equipe@ocdlive.com
