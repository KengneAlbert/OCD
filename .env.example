# ─── OCD Live — variables d'environnement ───────────────────────────────
# Copier ce fichier en .env.local (local) ou les saisir dans Vercel > Settings > Environment Variables.

# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ocdlive.com

# Numéro WhatsApp qui reçoit les réservations : format international SANS "+" ni espaces
# Exemple Togo : 22890123456
NEXT_PUBLIC_WHATSAPP_NUMBER=22890000000

# Canal d'envoi des CANDIDATURES (les réservations partent toujours par email via Brevo) :
#   whatsapp → phase 1 (ouverture de WhatsApp avec le message pré-rempli)
#   brevo    → phase 2 (emails transactionnels Brevo uniquement)
#   both     → WhatsApp + emails Brevo
# ⚠️ Lue au build : redéployer après modification.

# ─── Phase 2 : Brevo (emails automatiques : réservations, candidatures, lives) ───
BREVO_API_KEY=
# Expéditeur validé dans Brevo (Senders & IP)
BREVO_SENDER_EMAIL=reservations@ocdlive.com
# Adresse de l'équipe qui reçoit les nouvelles réservations
OCD_TEAM_EMAIL=equipe@ocdlive.com
# Nom affiché comme expéditeur (facultatif, "OCD Live" par défaut)
BREVO_SENDER_NAME=OCD Live

# ─── Supabase : stockage des réservations + espace admin (/admin) ───────
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Clé secrète : uniquement côté serveur, ne JAMAIS la préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Emails autorisés à se connecter à /admin (séparés par des virgules).
# Créer ces utilisateurs dans Supabase > Authentication > Users.
ADMIN_EMAILS=equipe@ocdlive.com

# ─── Paiement Mobile Money : Swinmo Pay (https://pay.swinmo.shop/docs) ──
# Clé secrète (serveur uniquement) : sk_test_… en sandbox, sk_live_… après validation KYB.
# Sans cette clé, le paiement en ligne est simplement masqué.
SWINMO_SECRET_KEY=
# Secret du webhook (tableau de bord Swinmo > Développeurs > Webhooks).
# URL à déclarer : https://<ton-domaine>/api/payments/webhook (une par environnement).
SWINMO_WEBHOOK_SECRET=

# ─── Tâche du matin (Vercel Cron, voir vercel.json) ───
# Rappels J-1 aux clients + récap du jour à l'équipe, chaque jour à 6 h (Lomé).
# Vercel envoie ce secret automatiquement : chaîne aléatoire d'au moins 16 caractères.
CRON_SECRET=
